# Configuração da Porta do Servidor
PORT=3001
NODE_ENV=development

# Configuração da Conexão PostgreSQL / PostGIS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/angola_geomarketing

# Ou parâmetros individuais (caso não utilize DATABASE_URL):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=angola_geomarketing

# Limites operacionais do Pool de Conexões
PG_MAX_POOL=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
