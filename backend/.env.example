# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - GPS DE MARKETING POLÍTICO ANGOLA 2027
# ==============================================================================

# Servidor HTTP
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Segurança & Autenticação JWT (Em produção, gere uma chave forte com openssl rand -hex 32)
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria_em_producao

# IA Anthropic Claude (Etapa 3 - Discursos de Campanha)
ANTHROPIC_API_KEY=sua_chave_da_anthropic_aqui
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Conexão PostgreSQL / PostGIS
DATABASE_URL=postgresql://usuario:senha_forte@localhost:5432/angola_geomarketing

# Parâmetros individuais (caso não use DATABASE_URL):
PGHOST=localhost
PGPORT=5432
PGUSER=angola_admin
PGPASSWORD=defina_uma_senha_segura_aqui
PGDATABASE=angola_geomarketing

# Pool de Conexões do PostgreSQL
PG_MAX_POOL=25
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
