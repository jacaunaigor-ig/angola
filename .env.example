# ==========================================================
# Aplicação / Ambiente
# ==========================================================
APP_NAME="campanha-eleitoral"
APP_ENV="development"                  # development | test | staging | production
DEBUG="false"
LOG_LEVEL="INFO"                      # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ==========================================================
# Banco de Dados PostgreSQL / PostGIS
# ==========================================================
# Opção 1: usar DATABASE_URL diretamente
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/angola_geomarketing?sslmode=prefer"
POSTGRES_DB="angola_geomarketing"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me"

# Opção 2: preencher as variáveis abaixo quando não usar DATABASE_URL
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="angola_campaign"
DATABASE_USER="postgres"
DATABASE_PASSWORD="change_me"
DATABASE_SSLMODE="prefer"             # disable | allow | prefer | require
DATABASE_CONN_TIMEOUT="5"
DATABASE_POOL_MIN_SIZE="5"
DATABASE_POOL_MAX_SIZE="20"

# ==========================================================
# Autenticação JWT / Segurança
# ==========================================================
JWT_SECRET_KEY="mude-esta-chave-para-um-segredo-forte-com-pelo-menos-32-caracteres"
JWT_ALGORITHM="HS256"                 # HS256 | HS384 | HS512
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="60"
JWT_REFRESH_TOKEN_EXPIRE_DAYS="7"
JWT_ISSUER="angola-campaign"

# ==========================================================
# Credenciais de IA / PLN
# ==========================================================
AI_PROVIDER="local"                  # local | anthropic
AI_MODEL="claude-3-5-sonnet-20241022"
AI_TEMPERATURE="0.2"
AI_MAX_TOKENS="2048"

ANTHROPIC_API_KEY=""
ANTHROPIC_API_URL="https://api.anthropic.com"
OPENAI_API_KEY=""
OPENAI_API_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ==========================================================
# CORS / Cross-Origin Resource Sharing
# ==========================================================
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:3000"
CORS_ALLOW_CREDENTIALS="true"
CORS_ALLOW_METHODS="GET,POST,PUT,PATCH,DELETE,OPTIONS"
CORS_ALLOW_HEADERS="Authorization,Content-Type,X-Requested-With,Accept,X-Plano-Campanha"

# ==========================================================
# Rate Limit / Proteção contra abuso
# ==========================================================
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_PER_MINUTE="120"
RATE_LIMIT_BURST="20"
RATE_LIMIT_STORAGE_BACKEND="memory"   # memory | redis

# ==========================================================
# Observabilidade / Logs
# ==========================================================
LOG_FORMAT="json"                     # json | text
LOG_TO_CONSOLE="true"
LOG_FILE_PATH="logs/app.log"
OTEL_SERVICE_NAME="angola-campaign-api"
OTEL_TRACES_EXPORTER="otlp"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# ==========================================================
# Configurações do Backend / API
# ==========================================================
API_PREFIX="/api"
API_HOST="0.0.0.0"
API_PORT="8000"
API_AUTH_TOKEN=""                      # JWT válido do utilizador autorizado do War Room
REQUEST_TIMEOUT_SECONDS="30"

# ==========================================================
# Configuração de cache / sessão (opcional)
# ==========================================================
REDIS_URL="redis://localhost:6379/0"
SESSION_COOKIE_SECURE="false"
SESSION_COOKIE_SAMESITE="lax"

# ==========================================================
# Mobile Expo (valores públicos, não incluir segredos)
# ==========================================================
EXPO_PUBLIC_API_BASE_URL="http://localhost:8000/api"
EXPO_PUBLIC_CAMPAIGN_ID="a0000000-0000-0000-0000-000000000001"

# ==========================================================
# Mantenha este arquivo fora do controle de versão e copie para .env
# antes de subir a aplicação em ambiente local ou de produção.
# ==========================================================
